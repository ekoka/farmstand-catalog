import URI from 'urijs'
import expand from 'urijs/src/URITemplate'

// TODO: make 'host' configurable

export function HAL(resource){
    return HALResource(resource)
}

export function HALResource( resource={} ) {
    const rv = Object.create(HALResourcePrototype, {
      resource: {value: resource},
        _links: {value: resource._links || {}},
    })
    rv._halifyEmbedded()
    return rv
}

const HALResourcePrototype = {

    _halifyEmbedded() {
        this._embedded = {}
        if (!this.resource._embedded) return 

        let rv = {}
        let embedded = this.resource._embedded
        Object.keys(embedded).forEach((k, _) => {
            if (Array.isArray(embedded[k])) {
                rv[k] = embedded[k].map( el => HALResource(el) )
            } else {
                rv[k] = HALResource(embedded[k])
            }
        })
        this._embedded = rv
    },

    _link(rel) {
        if (this._links[rel]) {
            return this._links[rel]
        }
        return this._namespacedRel(rel)
    },

    // property getter
    get self() {
        return this.url('self')
    },

    findIndex(collectionName, item) {
        const collection = this.embedded(collectionName)
        return collection.findIndex( el => HALResource(el).self===item.self )
    },

    // update one item in a collection
    updateItem ({collection, identifier, replacement}){
        // get the actual collection
        collection = this.resource._embedded[collection]
        if (!collection || !Array.isArray(collection)){
            // TODO raise an error
            return
        }
        const idx = collection.findIndex(item=>{
            return item[identifier]==replacement[identifier]
        })
        if (idx < 0){
            // not found
            return
        }
        // replace item with replacement
        collection.splice(idx, 1, replacement)
        return true;
    },

    deleteItem ({collection, identifier, value}){
        collection = this.resource._embedded[collection]
        if (!collection || !Array.isArray(collection)){
            // TODO raise an error
            return
        }
        const idx = collection.findIndex(item=>{
            return item[identifier]==value
        })
        if (idx < 0){
            // not found
            return
        }
        // delete item
        collection.splice(idx, 1)
        return true;
    },

    href (rel){
        let link = this._link(rel)
        if(link==undefined){
            return
        }
        return link.href
    },

    url (rel, params, qsparams={}){
        let href = this.href(rel)
        if(!href){
            return
        }
        if (!params) {
            params = {}
        }
        const uri = URI.expand(href, params).search(qsparams)
        //if(uri.is('absolute')){
        return uri.toString()
        //}
        //return uri.absoluteTo(this.host).toString()
    },

    // property getter
    get _curies () {
        return this._links.curies || []
    },

    // property getter
    get _namespaces (){
        return this._curies.map(c=>{
            return c['name']
        })
    },

    _namespacedRel (relation){

        if (this._namespaces.length==0){
            return
        }

        const key = Object.keys(this._links).find(rel=>{
            // skipping the 'curies' relation
            if (rel=='curies'){
                return
            }
            return this._namespaces.find(ns=>{
                return rel==ns + ':' + relation
            })
        })
        return this._links[key]
    },

    // property getter
    get data (){
        // no resource
        if (!this.resource || Object.keys(this.resource).length===0) return

        const res = {}
        Object.keys(this.resource).forEach( k => {
            if ( k==='_embedded' || k==='_links' ) return
            res[k] = this.resource[k]
        })
        return JSON.parse(JSON.stringify(res))
    },

    // alias of key()
    prop (p){
        return this.resource[p]
    },

    // alias of prop()
    key (k){
        return this.resource[k]
    },

    embedded (prop){
        return this._embedded[prop]
    },

    // getter
    get isPartial (){
        return this.resource._partial ? true : false
    },
}
